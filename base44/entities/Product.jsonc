{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product title"
    },
    "handle": {
      "type": "string",
      "description": "URL handle"
    },
    "descriptionHtml": {
      "type": "string",
      "description": "HTML description"
    },
    "productType": {
      "type": "string",
      "description": "Product type (mug, poster...)"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor name (Gelato, Zeu Hi's...)"
    },
    "status": {
      "type": "string",
      "description": "Product status"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags"
    },
    "productUid": {
      "type": "string",
      "description": "Gelato product UID"
    },
    "catalogUid": {
      "type": "string",
      "description": "Gelato catalog UID"
    },
    "catalogTitle": {
      "type": "string",
      "description": "Gelato catalog title"
    },
    "attributes": {
      "type": "object",
      "description": "Gelato product attributes"
    },
    "weight": {
      "type": "object",
      "description": "Product weight"
    },
    "dimensions": {
      "type": "object",
      "description": "Product dimensions"
    },
    "gelatoPreviewUrl": {
      "type": "string",
      "description": "Gelato preview image URL"
    },
    "gelatoOrderLinks": {
      "type": "object",
      "description": "Map of gelatoVariantId -> order URL"
    },
    "variants": {
      "type": "array",
      "description": "Product variants",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "compareAtPrice": {
            "type": "string"
          },
          "inventoryQuantity": {
            "type": "number"
          },
          "shopifyVariantId": {
            "type": "string"
          },
          "gelatoVariantId": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "description": "Product images",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "altText": {
            "type": "string"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "collections": {
      "type": "array",
      "description": "Collection handles this product belongs to",
      "items": {
        "type": "string"
      }
    },
    "sortOrder": {
      "type": "number",
      "description": "Sort position within collection"
    }
  },
  "required": [
    "title"
  ]
}